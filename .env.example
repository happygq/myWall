# myWall 环境变量示例（复制后填写本地值；勿把真实 key 提交仓库）
#
# 推荐在桌面「编辑碟片 / 手工建卡」弹窗的「API Key」区块维护；
# 会写入本机 data/api_keys.json（已 gitignore，热读无需重启）。
# 环境变量 / config.py 仅作 json 未覆盖时的回退。

# HTTP_PROXY=http://127.0.0.1:10808
# HTTPS_PROXY=http://127.0.0.1:10808
# MYWALL_HTTP_PROXY=http://127.0.0.1:10808

# Flask
# MYWALL_SECRET_KEY=

# TMDb（https://www.themoviedb.org/settings/api ）
TMDB_API_KEY=
TMDB_ACCESS_TOKEN=

# OMDb / IMDb 片名搜索（https://www.omdbapi.com/apikey.aspx ）
OMDB_API_KEY=

# TheTVDB v4（https://thetvdb.com/api-information ）
TVDB_API_KEY=
# THETVDB_API_KEY=

# LM Studio OpenAI-compatible endpoint（Stage2 / 自动识别）
LMSTUDIO_BASE=http://127.0.0.1:1234
VISION_MODEL=zai-org/glm-4.6v-flash
# VISION_MODEL_AUTO=1
